PORT=5000
MONGO_URI=mongodb://localhost:27017/mediflow-ai
NODE_ENV=development

# Production only: your deployed frontend's origin, to restrict CORS.
# e.g. https://mediflow.vercel.app — leave blank for local dev (allows all).
CLIENT_URL=

# OCR - Tesseract.js runs locally, no key needed.
# Optional: use OCR.Space instead of Tesseract by setting a key here
OCR_SPACE_API_KEY=

# Optional: OpenAI is used only to clean up / normalize medicine names extracted by OCR.
# Leave blank to fall back to local fuzzy-matching only (no external calls).
OPENAI_API_KEY=

# Average minutes of service time per medicine item at a counter, used for wait-time prediction
AVG_SERVICE_MINUTES_PER_ITEM=2
